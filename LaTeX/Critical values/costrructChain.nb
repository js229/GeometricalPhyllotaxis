Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"addByAngle", "[", 
    RowBox[{"centres_", ",", "angle_"}], "]"}], " ", ":=", 
   RowBox[{"Append", "[", 
    RowBox[{"centres", ",", 
     RowBox[{
      RowBox[{"Last", "[", "centres", "]"}], "+", 
      RowBox[{"2", "*", 
       RowBox[{"(", 
        RowBox[{"N", "@", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "angle", "]"}], ",", 
           RowBox[{"Sin", "[", "angle", "]"}]}], "}"}]}], ")"}]}]}]}], 
