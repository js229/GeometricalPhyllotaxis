            RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "-", 
           RowBox[{"\[ImaginaryI]", " ", "m", " ", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}]]}], ")"}]}]}], ",", 
     RowBox[{"\"\<zn\>\"", "\[Rule]", 
      RowBox[{"\[CapitalDelta]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "v"}], "+", 
         FractionBox[
          RowBox[{"n", " ", 
           RowBox[{"(", 
            RowBox[{"v", "-", 
             RowBox[{"u", " ", 
              RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "-", 
             RowBox[{"\[ImaginaryI]", " ", "u", " ", 
              RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ")"}]}], 
          RowBox[{"n", "-", 
           RowBox[{"m", " ", 
            RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "-", 
           RowBox[{"\[ImaginaryI]", " ", "m", " ", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}]]}], ")"}]}]}], ",", 
     RowBox[{"\"\<pm\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        FractionBox[
         RowBox[{"n", "-", 
          RowBox[{"m", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], 
         RowBox[{
          SuperscriptBox["m", "2"], "+", 
          SuperscriptBox["n", "2"], "-", 
          RowBox[{"2", " ", "m", " ", "n", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], ",", 
        FractionBox[
         RowBox[{"m", " ", 
          RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
