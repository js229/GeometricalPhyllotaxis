       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "u"}], "+", 
         FractionBox[
          RowBox[{"m", " ", 
           RowBox[{"(", 
            RowBox[{"v", "-", 
             RowBox[{"u", " ", 
              RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "-", 
             RowBox[{"\[ImaginaryI]", " ", "u", " ", 
              RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ")"}]}], 
          RowBox[{"n", "-", 
