  FormBox[
   SubscriptBox["\[Alpha]", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c74f347b-e8fa-d045-aeb6-1eb553fd0b0e"],
 " with the positive x-axis. "
}], "Text",
