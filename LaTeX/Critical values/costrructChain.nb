Cell[BoxData[
 RowBox[{
  RowBox[{"tf", "=", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\"\<z1\>\"", "\[Rule]", 
      FractionBox[
       RowBox[{"v", "-", 
        RowBox[{"u", " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", "u", " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], 
       RowBox[{"n", "-", 
