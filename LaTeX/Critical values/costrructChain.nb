Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"angle", "=", 
   RowBox[{"N", "@", 
    RowBox[{"Abs", "[", 
     RowBox[{"angleForOrthogonalLatticeChain", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", "4"}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pm", "=", 
   RowBox[{"2", "*", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", "angle", "]"}], ",", 
      RowBox[{"Sin", "[", "angle", "]"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pn", " ", "=", " ", 
   RowBox[{"2", "*", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"angle", "+", 
        RowBox[{"\[Pi]", "/", "2"}]}], "]"}], ",", 
