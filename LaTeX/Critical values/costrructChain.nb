          SuperscriptBox["m", "2"], "+", 
          SuperscriptBox["n", "2"], "-", 
          RowBox[{"2", " ", "m", " ", "n", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]]}], "}"}]}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"\"\<pmRadius\>\"", "->", 
      RowBox[{"4", 
       SuperscriptBox["radius", "2"], "*", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "-", 
          RowBox[{"m", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ",", 
         RowBox[{"m", " ", 
          RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], "}"}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<pn\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"-", "m"}], "+", 
          RowBox[{"n", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], 
         RowBox[{
          SuperscriptBox["m", "2"], "+", 
          SuperscriptBox["n", "2"], "-", 
