      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"addVector", "[", "ch_", "]"}], " ", ":=", " ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"If", "[", " ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"N", "[", " ", 
              RowBox[{
               RowBox[{"Last", "[", "ch", "]"}], "+", "downVector"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", "<", "0"}], ",", 
           RowBox[{"Append", "[", 
            RowBox[{"ch", ",", 
             RowBox[{
              RowBox[{"Last", "[", "ch", "]"}], "+", "upVector"}]}], "]"}], ",", 
           RowBox[{"Append", "[", 
            RowBox[{"ch", ",", 
