Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"angleForOrthogonalLatticeChain", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m_", ",", "n_"}], "}"}], ",", "circumference_"}], "]"}], ":=",
     " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"z1", ",", "angle"}], "}"}], ",", "\[IndentingNewLine]", 
