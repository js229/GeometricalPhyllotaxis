       RowBox[{"angle", "+", 
        RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"angles", "=", 
