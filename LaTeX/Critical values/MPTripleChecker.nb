Cell[TextData[{
 "This generates an m,n chain with width exactly 1. \nThe angle that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "m"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d9081f57-cac2-bc4e-b0ca-d855e91cd6cd"],
 " makes with the horizontal is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", 
    RowBox[{"Arg", "[", 
     SubscriptBox["z", "m"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "07ebaf55-56c2-ad46-ba98-94a4225b77f5"],
 "]."
}], "Text",
 CellChangeTimes->{{3.9847436541224766`*^9, 
  3.984743760734167*^9}},ExpressionUUID->"c0c9ff7e-d72e-d348-ab49-\
ceb3f53b8125"],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{{3.9847537348090744`*^9, 3.9847537413232594`*^9}},
 CellLabel->"In[67]:=",ExpressionUUID->"15968643-87a5-944d-978e-7f83740771c2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"{", 
    RowBox[{"m", ",", "n", ",", "u", ",", "v"}], "}"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gmnAlgebraic", "[", "w_", "]"}], " ", ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"u", " ", "w"}], " ", "-", " ", "v"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"m", " ", "w"}], " ", "-", " ", "n"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gmnTrig", "[", 
     RowBox[{"s_", ",", "\[Theta]_"}], "]"}], " ", ":=", " ", 
    FractionBox[
     RowBox[{"v", "-", 
      RowBox[{"s", " ", "u", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "-", 
      RowBox[{"\[ImaginaryI]", " ", "s", " ", "u", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], 
     RowBox[{"n", "-", 
      RowBox[{"m", " ", "s", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "-", 
      RowBox[{"\[ImaginaryI]", " ", "m", " ", "s", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}]]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"algebraicRenormalisation", "[", 
   RowBox[{"{", 
    RowBox[{"mNumeric_", ",", "nNumeric_"}], "}"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "g", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"uNumeric", ",", "vNumeric"}], "}"}], "=", 
      RowBox[{"euclideanWindingNumberPair", "[", 
       RowBox[{"{", 
        RowBox[{"mNumeric", ",", "nNumeric"}], "}"}], "]"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"m", "=", "mNumeric"}], ";", 
     RowBox[{"n", "=", "nNumeric"}], ";", "\[IndentingNewLine]", 
     RowBox[{"z1", "=", " ", 
      RowBox[{
       RowBox[{"\[CapitalDelta]", "  ", 
        FractionBox[
         RowBox[{"v", "-", 
          RowBox[{"s", " ", "u", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "-", 
          RowBox[{"\[ImaginaryI]", " ", "s", " ", "u", " ", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], 
         RowBox[{"n", "-", 
          RowBox[{"m", " ", "s", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "-", 
          RowBox[{"\[ImaginaryI]", " ", "m", " ", "s", " ", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}]]}], " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"s", "->", "1"}], ",", 
         RowBox[{"\[Theta]", "->", "latticeAngle"}], ",", 
         RowBox[{"m", "->", "mNumeric"}], ",", 
         RowBox[{"n", "->", "nNumeric"}], ",", 
         RowBox[{"u", "->", "uNumeric"}], ",", 
         RowBox[{"v", "->", "vNumeric"}], "\[IndentingNewLine]", ",", " ", 
         RowBox[{"\[CapitalDelta]", "->", " ", 
          RowBox[{"euclideanDelta", "[", 
           RowBox[{"{", 
            RowBox[{"mNumeric", ",", "nNumeric"}], "}"}], "]"}]}]}], 
        "}"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"z1Coords", "=", 
      RowBox[{"ComplexExpand", "[", 
       RowBox[{"ReIm", "[", "z1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"pn", " ", "=", " ", 
      RowBox[{
       RowBox[{"n", " ", "z1Coords"}], " ", "-", " ", 
       RowBox[{"vNumeric", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}]}]}], " ", ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pm", "=", 
      RowBox[{
       RowBox[{"m", " ", "z1Coords"}], " ", "-", " ", 
       RowBox[{"uNumeric", "  ", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"z0", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"renorm", "=", " ", 
      RowBox[{
       RowBox[{"RotationTransform", "[", 
        RowBox[{"Arg", "[", "zm", "]"}], "]"}], "@*", " ", 
       RowBox[{"ScalingTransform", "[", 
        RowBox[{
         RowBox[{"Abs", "[", "zm", "]"}], "*", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"g1", "=", 
      RowBox[{"Graphics", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"GeometricTransformation", "[", 
          RowBox[{"diag", ",", "renorm"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"InfiniteLine", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
         RowBox[{"InfiniteLine", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
         RowBox[{"InfiniteLine", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", "Thick", ",", "\[IndentingNewLine]", " ", 
         "Blue", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", "pm"}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", "Green", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", "z0"}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", "Yellow", ",", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", "pn"}], "}"}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{"{", 
       RowBox[{"g1", ",", "g0"}], "}"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"algebraicRenormalisation", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", "3"}], "}"}], "]"}], "\[IndentingNewLine]"}], "Input",
