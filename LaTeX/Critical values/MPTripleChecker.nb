Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"algebraicForms", "[", 
      RowBox[{
      "m_", ",", "n_", ",", "u_", ",", "v_", ",", "s_", ",", "\[Theta]_", ",",
        "\[CapitalDelta]_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "z1", ",", "zm", ",", "zn", ",", "pm", ",", "pn", ",", 
         "renormalisation", ",", "h", ",", "d", ",", "gamma", ",", "DeltaIs", 
         ",", "GammaIs", ",", "hWithGamma", ",", "dWithGamma", ",", 
         "dAxisRange"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"DeltaIs", " ", "=", " ", 
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"-", "n"}], " ", "u"}], "+", 
             RowBox[{"m", " ", "v"}]}], " ", "->", " ", "\[CapitalDelta]"}], ",",
            " ", 
           RowBox[{
            RowBox[{
             RowBox[{"n", " ", "u"}], " ", "-", " ", 
             RowBox[{"m", " ", "v"}]}], " ", "->", " ", 
            RowBox[{"-", "\[CapitalDelta]"}]}], ",", " ", 
           RowBox[{
            SuperscriptBox["\[CapitalDelta]", "2"], "->", "1"}]}], "}"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"gamma", "=", 
         RowBox[{
          SuperscriptBox["n", "2"], "+", 
          RowBox[{
           SuperscriptBox["m", "2"], " ", 
           SuperscriptBox["s", "2"]}], "-", 
          RowBox[{"2", " ", "m", " ", "n", " ", "s", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"GammaIs", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{"gamma", "->", " ", "\[CapitalGamma]"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"z1", "=", "  ", 
         FractionBox[
          RowBox[{"v", "-", 
           RowBox[{"s", " ", "u", " ", 
            RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "-", 
           RowBox[{"\[ImaginaryI]", " ", "s", " ", "u", " ", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], 
          RowBox[{"n", "-", 
           RowBox[{"m", " ", "s", " ", 
            RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "-", 
           RowBox[{"\[ImaginaryI]", " ", "m", " ", "s", " ", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}]]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"zm", "=", "  ", 
         RowBox[{"\[CapitalDelta]", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"m", " ", "z1"}], " ", "-", " ", "u"}], ")"}]}]}], " ", ";",
         "\[IndentingNewLine]", 
        RowBox[{"zn", "=", " ", 
         RowBox[{"\[CapitalDelta]", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"n", " ", "z1"}], "-", " ", "v"}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pm", "=", 
         RowBox[{"Simplify", "@", 
          RowBox[{"ComplexExpand", "[", 
           RowBox[{"ReIm", "[", "zm", "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pm", " ", "=", " ", 
         RowBox[{"pm", " ", "//.", " ", "DeltaIs"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pn", "=", 
         RowBox[{"Simplify", "@", 
          RowBox[{"ComplexExpand", "[", 
           RowBox[{"ReIm", "[", "zn", "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pn", " ", "=", " ", 
         RowBox[{"pn", " ", "//.", " ", "DeltaIs"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"renormalisation", "=", " ", 
         RowBox[{
          RowBox[{"RotationTransform", "[", 
           RowBox[{"Arg", "[", "zm", "]"}], "]"}], "@*", " ", 
          RowBox[{"ScalingTransform", "[", 
           RowBox[{
            RowBox[{"Abs", "[", "zm", "]"}], "*", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"h", "=", " ", 
         RowBox[{"Simplify", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Simplify", "@", 
             RowBox[{"ComplexExpand", "[", 
              RowBox[{"Im", "[", "z1", "]"}], "]"}]}], "//.", " ", 
            "DeltaIs"}], "  ", "/.", " ", 
           RowBox[{"v", "\[Rule]", 
            FractionBox[
             RowBox[{
              RowBox[{"n", " ", "u"}], "+", "\[CapitalDelta]"}], "m"]}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"d", "=", " ", 
         RowBox[{
          RowBox[{"Simplify", "@", 
           RowBox[{"ComplexExpand", "[", 
            RowBox[{"Re", "[", "z1", "]"}], "]"}]}], "//.", " ", 
          "DeltaIs"}]}], " ", ";", "\[IndentingNewLine]", 
        RowBox[{"Which", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"TrueQ", "[", 
           RowBox[{"s", "==", "1"}], "]"}], ",", "\[IndentingNewLine]", "\t", 
          RowBox[{"dAxisRange", "=", " ", 
           RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ResourceFunction", "[", "\"\<SymbolQ\>\"", "]"}], "[", 
           "s", "]"}], ",", "\[IndentingNewLine]", "\t", 
          RowBox[{"dAxisRange", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Limit", "[", 
              RowBox[{"d", ",", 
               RowBox[{"s", "->", "\[Infinity]"}]}], "]"}], ",", 
             RowBox[{"d", "/.", " ", 
              RowBox[{"s", "->", "0"}]}]}], "}"}]}], ",", 
          "\[IndentingNewLine]", "True", ",", "\[IndentingNewLine]", "\t", 
          RowBox[{"dAxisRange", "=", 
           RowBox[{"Missing", "[", "]"}]}]}], "\[IndentingNewLine]", "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"hWithGamma", "=", 
         RowBox[{"h", "/.", " ", "GammaIs"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"dWithGamma", "=", 
         RowBox[{"d", "/.", " ", "GammaIs"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\"\<z1\>\"", "->", "z1"}], "\[IndentingNewLine]", ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<zm\>\"", " ", "->", "  ", "zm"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<zn\>\"", "->", " ", "zn"}], "\[IndentingNewLine]", ",", 
          RowBox[{"\"\<pm\>\"", "->", "pm"}], ",", 
          RowBox[{"\"\<pn\>\"", "->", "pn"}], "\[IndentingNewLine]", ",", 
          RowBox[{"\"\<tanAlpham\>\"", "->", 
           RowBox[{
            RowBox[{"pm", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "/", 
            RowBox[{"pm", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
          RowBox[{"\"\<tanAlphan\>\"", "->", 
           RowBox[{
            RowBox[{"pn", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "/", 
            RowBox[{"pn", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<renormalisation\>\"", "->", "renormalisation"}], 
          "\[IndentingNewLine]", ",", 
          RowBox[{"\"\<h\>\"", "->", "h"}], ",", 
          RowBox[{"\"\<d\>\"", "->", "d"}], ",", 
          RowBox[{"\"\<\[CapitalGamma]\>\"", "->", "gamma"}], 
