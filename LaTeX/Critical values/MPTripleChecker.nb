Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"copied", " ", "from", " ", "Geometrical", " ", "Phyllotaxis"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"euclideanWindingNumberPair", "[", "mn_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", "n", ",", "u", ",", "v"}], "}"}], ",", "\n", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"m", ",", "u"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "v"}], "}"}]}], "}"}], "=", " ", 
         RowBox[{"euclideanMatrixProduct", "[", "mn", "]"}]}], ";", "\n", 
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}]}]}], "\n", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eMatrix", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{"{", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], ",", "\n", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], "\n", "}"}], ")"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sMatrix", "=", 
     RowBox[{"(", 
      RowBox[{"{", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}], ",", "\n", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "\n", "}"}], ")"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"euclideanMatrixProduct", "[", "mn_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q", ",", "res"}], "}"}], ",", "\n", 
        RowBox[{
         RowBox[{"q", " ", "=", " ", 
          RowBox[{"euclideanQCoefficients", "[", "mn", "]"}]}], ";", "\n", 
         RowBox[{"res", "=", " ", 
          RowBox[{"(", 
           RowBox[{"Map", "[", "  ", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"MatrixPower", "[", 
                RowBox[{"eMatrix", ",", "#"}], "]"}], " ", ".", " ", 
               "sMatrix"}], " ", "&"}], ",", "q"}], "]"}], ")"}]}], ";", "\n", 
         RowBox[{"res", "=", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "res", "]"}], ">", "0"}], ",", 
            RowBox[{"Dot", "@@", "res"}], ",", 
            RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], ";", "\n", 
         RowBox[{"res", " ", "=", " ", 
          RowBox[{"sMatrix", " ", ".", " ", "res"}]}], ";", "\n", "\n", 
         "res"}]}], "\n", "]"}], "/;", " ", 
      RowBox[{"NumericQ", "[", 
       RowBox[{"First", "[", "mn", "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"euclideanMatrixProduct", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], "]"}], " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{"{", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}], ",", "\n", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "\n", "}"}], ")"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"euclideanMatrixProduct", "[", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], "]"}], " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{"{", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}], ",", "\n", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}]}], "\n", "}"}], ")"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"euclideanDelta", "[", "mn_", "]"}], "  ", ":=", " ", 
     RowBox[{"Det", "@", 
      RowBox[{"euclideanMatrixProduct", "[", "mn", "]"}]}]}], ";"}], "\n", 
   "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"euclideanQCoefficients", "[", 
      RowBox[{"{", 
       RowBox[{"m_", ",", "n_"}], "}"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", "q", ",", "i"}], "}"}], ",", "\n", "\t", 
       RowBox[{
        RowBox[{"i", "=", "0"}], ";", "\n", "\t", 
        RowBox[{
         RowBox[{"r", "[", 
          RowBox[{"-", "1"}], "]"}], "=", "n"}], ";", " ", "\n", "\t", 
        RowBox[{
         RowBox[{"r", "[", "0", "]"}], " ", "=", " ", "m"}], ";", "\n", "\t", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"r", "[", "i", "]"}], " ", ">", " ", "0"}], "  ", ",", " ",
           "\n", "\t\t", 
          RowBox[{
           RowBox[{
            RowBox[{"q", "[", "i", "]"}], " ", "=", " ", 
            RowBox[{"Floor", "[", 
             RowBox[{
              RowBox[{"r", "[", 
               RowBox[{"i", "-", "1"}], "]"}], "/", 
              RowBox[{"r", "[", "i", "]"}]}], "]"}]}], ";", "\n", "\t\t", 
           RowBox[{
            RowBox[{"r", "[", 
             RowBox[{"i", "+", "1"}], "]"}], " ", "=", " ", 
            RowBox[{
             RowBox[{"r", "[", 
              RowBox[{"i", "-", "1"}], "]"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"q", "[", "i", "]"}], "*", 
              RowBox[{"r", "[", "i", "]"}]}]}]}], ";", "\n", "\t\t", 
           RowBox[{"i", "++"}], ";"}]}], "\n", "\t", "]"}], ";", "\n", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"q", "[", "j", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", 
            RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}]}]}], "\n", "]"}]}], 
    ";"}], "\n"}]}]], "Input",
